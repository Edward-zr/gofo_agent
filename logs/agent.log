SELECT
    d.hub,
    COUNT(*) AS pickup_count,
    SUM(CASE WHEN p.status='Delayed' THEN 1 ELSE 0 END) AS delayed_pickups,
    SUM(CASE WHEN p.status='Failed' THEN 1 ELSE 0 END) AS failed_pickups,
    SUM(p.package_count) AS package_count
FROM pickups p
