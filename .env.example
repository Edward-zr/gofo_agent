# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database
SQLITE_DATABASE=data/gofo_demo.db
MEMORY_DATABASE=data/memory.db

# Chroma
CHROMA_PERSIST_DIR=chroma_db
COLLECTION_NAME=gofo_sop

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
DEBUG=false

# Intent classifier + multi-step planner (set false to use legacy IntentRouter dispatch)
INTENT_CLASSIFIER_ENABLED=true
PLANNER_ENABLED=true
DATA_SOURCE_SELECTION_ENABLED=true

# Quality assurance pipeline (evaluate answers; never generates final text)
QUALITY_ASSURANCE_ENABLED=true
QA_MAX_RETRIES=2
QA_SCORE_THRESHOLD=0.75
QA_APPROVE_THRESHOLD=0.85

# Reflection / self-critique (primary critic; uses QA validators under the hood)
REFLECTION_ENABLED=true
REFLECTION_USE_LLM=false
REFLECTION_MAX_RETRIES=2

# Tool orchestration (parallel waves + AgentState)
TOOL_ORCHESTRATOR_ENABLED=true
TOOL_ORCHESTRATOR_PARALLEL=true
TOOL_ORCHESTRATOR_MAX_WORKERS=4

# Multi-agent Supervisor + Agent Registry (capability routing)
MULTI_AGENT_ENABLED=true
MULTI_AGENT_PARALLEL=true
MULTI_AGENT_MAX_WORKERS=4
MULTI_AGENT_DEBUG=false
MULTI_AGENT_REFLECTION=false

PYTHON_TOOLS_DEBUG=false

# Schema retriever (SQL agent — only relevant tables/columns to the LLM)
SCHEMA_RETRIEVER_ENABLED=true
SCHEMA_RETRIEVER_DEBUG=false
SCHEMA_EMBEDDING_RETRIEVAL_ENABLED=false

# Clarification manager (ask before SQL/RAG/Python when parameters are missing)
CLARIFICATION_MANAGER_ENABLED=true
CLARIFICATION_DEBUG=false

# Adaptive Retrieval Confidence Engine (multi-signal score before generation)
RETRIEVAL_CONFIDENCE_ENABLED=true
RETRIEVAL_CONFIDENCE_DEBUG=false
RETRIEVAL_CONFIDENCE_HIGH=0.80
RETRIEVAL_CONFIDENCE_MEDIUM=0.60

# Prompt Registry (versioned prompt assets)
PROMPT_REGISTRY_DIR=prompts
PROMPT_HOT_RELOAD=false
PROMPT_DEBUG=false
# Example experiment override: planner.planner_prompt:v2,rag.generator_prompt:v1
PROMPT_EXPERIMENT=
# Optional weight overrides (normalized at runtime)
# RETRIEVAL_CONF_W_HIGHEST=0.40
# RETRIEVAL_CONF_W_AVERAGE=0.30
# RETRIEVAL_CONF_W_CHUNKS=0.15
# RETRIEVAL_CONF_W_DIVERSITY=0.10
# RETRIEVAL_CONF_W_METADATA=0.05

# Uploads
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=pdf,csv,xlsx,xls,txt,md,docx,png,jpg,jpeg,webp
