# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database
SQLITE_DATABASE=data/gofo_demo.db
MEMORY_DATABASE=data/memory.db

# Chroma
CHROMA_PERSIST_DIR=chroma_db
COLLECTION_NAME=gofo_sop

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
DEBUG=false

# Intent classifier + multi-step planner (set false to use legacy IntentRouter dispatch)
INTENT_CLASSIFIER_ENABLED=true
PLANNER_ENABLED=true

# Quality assurance pipeline (evaluate answers; never generates final text)
QUALITY_ASSURANCE_ENABLED=true
QA_MAX_RETRIES=2
QA_SCORE_THRESHOLD=0.75
QA_APPROVE_THRESHOLD=0.85

# Reflection / self-critique (primary critic; uses QA validators under the hood)
REFLECTION_ENABLED=true
REFLECTION_USE_LLM=false
REFLECTION_MAX_RETRIES=2

# Tool orchestration (parallel waves + AgentState)
TOOL_ORCHESTRATOR_ENABLED=true
TOOL_ORCHESTRATOR_PARALLEL=true
TOOL_ORCHESTRATOR_MAX_WORKERS=4

# Uploads
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=pdf,csv,xlsx,xls,txt,md,docx,png,jpg,jpeg,webp
